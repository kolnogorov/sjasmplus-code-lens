{
    "name": "sjasmplus-code-lens",
    "displayName": "sjasmplus Code Lens",
    "version": "0.1.10",
    "publisher": "kolnogorov",
    "description": "Code lens, references, go to definition, rename, outline and hover for Z80 assembly written for sjasmplus.",
    "author": {
        "name": "Alexander Kolnogorov"
    },
    "license": "MIT",
    "keywords": [
        "sjasmplus",
        "z80",
        "zx spectrum",
        "assembler",
        "code lens",
        "multi-root ready"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/kolnogorov/sjasmplus-code-lens"
    },
    "bugs": {
        "url": "https://github.com/kolnogorov/sjasmplus-code-lens/issues"
    },
    "qna": "https://t.me/sjasmpluscodelens",
    "engines": {
        "vscode": "^1.71.0"
    },
    "icon": "assets/local/icon.png",
    "categories": [
        "Programming Languages",
        "Formatters",
        "Linters"
    ],
    "preview": true,
    "activationEvents": [
        "workspaceContains:**/*.{asm,a80,z80,inc}",
        "onLanguage:asm-collection",
        "onLanguage:z80-macroasm",
        "onLanguage:z80-asm",
        "onLanguage:asm-z80-sjasmplus",
        "onLanguage:asm-x86-nasm",
        "onLanguage:asm-x86-gas",
        "onLanguage:asm-x86-masm"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "views": {
            "explorer": [
                {
                    "type": "webview",
                    "id": "sjasmplus-code-lens.calcview-explorer",
                    "name": "Hexadecimal Calculator",
                    "icon": "assets/local/hexcalc_icon.svg",
                    "contextualTitle": "Hex Calculator",
                    "when": "config.sjasmplus-code-lens.hexCalculator.showInExplorer"
                }
            ],
            "debug": [
                {
                    "type": "webview",
                    "id": "sjasmplus-code-lens.calcview-debug",
                    "name": "Hexadecimal Calculator",
                    "icon": "assets/local/hexcalc_icon.svg",
                    "contextualTitle": "Hex Calculator",
                    "when": "config.sjasmplus-code-lens.hexCalculator.showInDebug"
                }
            ]
        },
        "configuration": {
            "type": "object",
            "title": "sjasmplus Code Lens",
            "properties": {
                "sjasmplus-code-lens.enableWorkspaceSymbols": {
                    "order": 11,
                    "scope": "resource",
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Enable/disable ['Open symbol by name'](https://code.visualstudio.com/docs/editor/editingevolved#_open-symbol-by-name)"
                },
                "sjasmplus-code-lens.workspaceSymbolsRequiredLength": {
                    "order": 12,
                    "scope": "resource",
                    "type": "number",
                    "default": 2,
                    "markdownDescription": "The number of characters required before symbols will be presented."
                },
                "sjasmplus-code-lens.enableOutlineView": {
                    "order": 21,
                    "scope": "resource",
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Enable/disable outline view for the active document."
                },
                "sjasmplus-code-lens.enableCodeLenses": {
                    "order": 31,
                    "scope": "resource",
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Enable/disable the display of code lenses ([references](https://code.visualstudio.com/docs/editor/editingevolved#_reference-information)) above labels."
                },
                "sjasmplus-code-lens.enableHovering": {
                    "order": 41,
                    "scope": "resource",
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Enable/disable showing the comments while hovering labels etc."
                },
                "sjasmplus-code-lens.enableCompletions": {
                    "order": 51,
                    "scope": "resource",
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Enable/disable symbol input completion."
                },
                "sjasmplus-code-lens.completionsRequiredLength": {
                    "order": 52,
                    "scope": "resource",
                    "type": "number",
                    "default": 1,
                    "markdownDescription": "The number of characters required before completion proposals will be presented."
                },
                "sjasmplus-code-lens.enableGotoDefinition": {
                    "order": 61,
                    "scope": "resource",
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Enable/disable ['Go to Definition'](https://code.visualstudio.com/docs/editor/editingevolved#_go-to-definition)."
                },
                "sjasmplus-code-lens.enableFindAllReferences": {
                    "order": 71,
                    "scope": "resource",
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Enable/disable 'Find All References'."
                },
                "sjasmplus-code-lens.enableRenaming": {
                    "order": 81,
                    "scope": "resource",
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Enable/disable [renaming](https://code.visualstudio.com/docs/editor/editingevolved#_rename-symbol) of labels, structs, fields, macros, defines and modules."
                },
                "sjasmplus-code-lens.enableFolding": {
                    "order": 86,
                    "scope": "resource",
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Enable/disable the folding of e.g. labels in asm files."
                },
                "sjasmplus-code-lens.enableFormatting": {
                    "order": 87,
                    "scope": "resource",
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Enable/disable formatting (\"Format Document\", \"Format Selection\"). Tabs or spaces and the tab size come from `editor.insertSpaces` and `editor.tabSize`."
                },
                "sjasmplus-code-lens.enableSemanticHighlighting": {
                    "order": 88,
                    "scope": "resource",
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Color symbols by what they are (labels of code, data, constants, structs, fields, macros, defines, modules), from the symbol index. Needs `editor.semanticHighlighting.enabled` (on for most themes)."
                },
                "sjasmplus-code-lens.format.indentation": {
                    "order": 131,
                    "scope": "resource",
                    "type": "string",
                    "enum": [
                        "align",
                        "keep"
                    ],
                    "enumDescriptions": [
                        "Move statements to the instruction column (directives that are left of the instructions to the directive column). Lines indented deeper than the instruction column are nested code and keep their offset.",
                        "Leave the indentation as it is."
                    ],
                    "default": "align",
                    "markdownDescription": "Indentation of the statements."
                },
                "sjasmplus-code-lens.format.instructionColumn": {
                    "order": 132,
                    "scope": "resource",
                    "type": "integer",
                    "minimum": 0,
                    "default": 0,
                    "markdownDescription": "Column of the instructions, counted from 0 (e.g. 24 = three tabs of width 8). 0 = the most frequent column in the file. With a column set, nested code keeps its offset."
                },
                "sjasmplus-code-lens.format.directiveColumn": {
                    "order": 133,
                    "scope": "resource",
                    "type": "integer",
                    "minimum": 0,
                    "default": 0,
                    "markdownDescription": "Column of directives written left of the instructions, e.g. `MODULE`, `IFDEF` (0 = the most frequent such column in the file). Counted from 0."
                },
                "sjasmplus-code-lens.format.case": {
                    "order": 134,
                    "scope": "resource",
                    "type": "string",
                    "enum": [
                        "keep",
                        "lower",
                        "upper"
                    ],
                    "default": "keep",
                    "markdownDescription": "Case of instructions, directives, registers, conditions and operator words. Labels, macros and strings are never changed."
                },
                "sjasmplus-code-lens.format.commaSpace": {
                    "order": 135,
                    "scope": "resource",
                    "type": "string",
                    "enum": [
                        "keep",
                        "none",
                        "space"
                    ],
                    "enumDescriptions": [
                        "Leave as it is.",
                        "`ld a,b`",
                        "`ld a, b`"
                    ],
                    "default": "keep",
                    "markdownDescription": "Whitespace after commas between operands. The double comma of multi-argument instructions (`,,`) stays together."
                },
                "sjasmplus-code-lens.format.operandSpacing": {
                    "order": 136,
                    "scope": "resource",
                    "type": "string",
                    "enum": [
                        "keep",
                        "space",
                        "tab"
                    ],
                    "default": "keep",
                    "markdownDescription": "Whitespace between the instruction and its operands."
                },
                "sjasmplus-code-lens.format.trailingComments": {
                    "order": 137,
                    "scope": "resource",
                    "type": "string",
                    "enum": [
                        "align",
                        "keep"
                    ],
                    "enumDescriptions": [
                        "Align comments after code: within each group of consecutive lines, or to `format.commentColumn`.",
                        "Leave as it is."
                    ],
                    "default": "align",
                    "markdownDescription": "Comments after code. Comments on their own line are not changed."
                },
                "sjasmplus-code-lens.format.commentColumn": {
                    "order": 138,
                    "scope": "resource",
                    "type": "integer",
                    "minimum": 0,
                    "default": 0,
                    "markdownDescription": "Column of comments after code, counted from 0. 0 = aligned within each group of consecutive lines, to their most frequent column."
                },
                "sjasmplus-code-lens.comments.toggleLineCommentPrefix": {
                    "order": 91,
                    "scope": "application",
                    "markdownDescription": "Configure the prefix used when toggling the line comment.",
                    "type": "string",
                    "default": ";"
                },
                "sjasmplus-code-lens.enablePushPopMatching": {
                    "order": 92,
                    "scope": "application",
                    "markdownDescription": "Enable highlighting of matching push/pop pairs.",
                    "type": "boolean",
                    "default": true
                },
                "sjasmplus-code-lens.includePaths": {
                    "order": 105,
                    "scope": "resource",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "markdownDescription": "Directories searched for `INCLUDE` files, like the sjasmplus options `-i`/`--inc`. Relative paths are relative to the workspace folder, `${workspaceFolder}` may be used. The workspace folder itself is always searched."
                },
                "sjasmplus-code-lens.dirbol": {
                    "order": 106,
                    "scope": "resource",
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Recognize directives at the beginning of a line, like the sjasmplus option `--dirbol`."
                },
                "sjasmplus-code-lens.defines": {
                    "order": 107,
                    "scope": "resource",
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "markdownDescription": "Defines set on the sjasmplus command line (`-D`), e.g. `[\"_DEBUG_\"]`. Used to know which `IFDEF`/`IFNDEF` blocks are assembled."
                },
                "sjasmplus-code-lens.diagnostics.unresolvedLabels": {
                    "order": 108,
                    "scope": "resource",
                    "type": "string",
                    "enum": [
                        "off",
                        "hint",
                        "information",
                        "warning",
                        "error"
                    ],
                    "default": "warning",
                    "markdownDescription": "Report references to labels that are not defined. Not reported: blocks that are not assembled, macro arguments and bodies, define values, and files that no program (a main file with `DEVICE`, `OUTPUT` or `SAVE...`) includes."
                },
                "sjasmplus-code-lens.dimInactiveBlocks": {
                    "order": 109,
                    "scope": "resource",
                    "type": "boolean",
                    "default": true,
                    "markdownDescription": "Dim the lines of `IFDEF`/`IFNDEF` blocks that are not assembled (see `defines`)."
                },
                "sjasmplus-code-lens.excludeFiles": {
                    "order": 111,
                    "scope": "resource",
                    "type": "string",
                    "default": "",
                    "markdownDescription": "Choose what files or directories to exclude, e.g. `**/{old,_archive}/**`."
                },
                "sjasmplus-code-lens.hexCalculator.showInExplorer": {
                    "order": 121,
                    "scope": "window",
                    "markdownDescription": "Set to false to disable calculator in explorer view.",
                    "type": "boolean",
                    "default": true
                },
                "sjasmplus-code-lens.hexCalculator.showInDebug": {
                    "order": 122,
                    "scope": "resource",
                    "markdownDescription": "Set to false to disable calculator in debug view.",
                    "type": "boolean",
                    "default": true
                },
                "sjasmplus-code-lens.hexCalculator.hexPrefix": {
                    "order": 123,
                    "scope": "application",
                    "markdownDescription": "The prefix to use for hex values, e.g. `0x` or `$`",
                    "type": "string",
                    "default": "0x"
                }
            }
        },
        "commands": [
            {
                "command": "sjasmplus-code-lens.find-labels-with-no-reference",
                "title": "Find Labels with no Reference",
                "category": "sjasmplus"
            },
            {
                "command": "sjasmplus-code-lens.check-file-associations",
                "title": "Check file associations",
                "category": "sjasmplus"
            },
            {
                "command": "sjasmplus-code-lens.fix-file-associations",
                "title": "Associate assembler files with sjasmplus in this workspace",
                "category": "sjasmplus"
            },
            {
                "command": "sjasmplus-code-lens.dezog.movePCtoCursor",
                "title": "Move Program Counter to Cursor",
                "category": "sjasmplus"
            },
            {
                "command": "sjasmplus-code-lens.dezog.disassemblyAtCursor.code",
                "title": "Code",
                "category": "sjasmplus"
            },
            {
                "command": "sjasmplus-code-lens.dezog.disassemblyAtCursor.data",
                "title": "Data",
                "category": "sjasmplus"
            },
            {
                "command": "sjasmplus-code-lens.dezog.disassemblyAtCursor.string",
                "title": "String",
                "category": "sjasmplus"
            },
            {
                "command": "sjasmplus-code-lens.dezog.analyzeAtCursor.disassembly",
                "title": "Smart Disassembly",
                "category": "sjasmplus"
            },
            {
                "command": "sjasmplus-code-lens.dezog.analyzeAtCursor.flowChart",
                "title": "Flow Chart",
                "category": "sjasmplus"
            },
            {
                "command": "sjasmplus-code-lens.dezog.analyzeAtCursor.callGraph",
                "title": "Call Graph",
                "category": "sjasmplus"
            }
        ],
        "submenus": [
            {
                "id": "sjasmplus-code-lens.dezog.disassemblyAtCursor",
                "label": "Disassembly at Cursor / of Selection"
            },
            {
                "id": "sjasmplus-code-lens.dezog.analyzeAtCursor",
                "label": "Analyze at Cursor"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "when": "resourceLangId == sjasmplus || resourceLangId == sjasmplus-list",
                    "command": "sjasmplus-code-lens.find-labels-with-no-reference",
                    "group": "0_navigation@10"
                },
                {
                    "when": "debugType == dezog && resourceLangId == sjasmplus || debugType == dezog && resourceLangId == sjasmplus-list",
                    "command": "sjasmplus-code-lens.dezog.movePCtoCursor",
                    "group": "debug"
                },
                {
                    "when": "debugType == dezog && resourceLangId == sjasmplus || debugType == dezog && resourceLangId == sjasmplus-list",
                    "submenu": "sjasmplus-code-lens.dezog.disassemblyAtCursor",
                    "group": "debug"
                },
                {
                    "when": "debugType == dezog && resourceLangId == sjasmplus || debugType == dezog && resourceLangId == sjasmplus-list",
                    "submenu": "sjasmplus-code-lens.dezog.analyzeAtCursor",
                    "group": "debug"
                }
            ],
            "sjasmplus-code-lens.dezog.disassemblyAtCursor": [
                {
                    "command": "sjasmplus-code-lens.dezog.disassemblyAtCursor.code"
                },
                {
                    "command": "sjasmplus-code-lens.dezog.disassemblyAtCursor.data"
                },
                {
                    "command": "sjasmplus-code-lens.dezog.disassemblyAtCursor.string"
                }
            ],
            "sjasmplus-code-lens.dezog.analyzeAtCursor": [
                {
                    "command": "sjasmplus-code-lens.dezog.analyzeAtCursor.disassembly"
                },
                {
                    "command": "sjasmplus-code-lens.dezog.analyzeAtCursor.flowChart"
                },
                {
                    "command": "sjasmplus-code-lens.dezog.analyzeAtCursor.callGraph"
                }
            ],
            "commandPalette": [
                {
                    "command": "sjasmplus-code-lens.find-labels-with-no-reference",
                    "when": "false"
                },
                {
                    "command": "sjasmplus-code-lens.dezog.movePCtoCursor",
                    "when": "false"
                },
                {
                    "command": "sjasmplus-code-lens.dezog.disassemblyAtCursor.code",
                    "when": "false"
                },
                {
                    "command": "sjasmplus-code-lens.dezog.disassemblyAtCursor.data",
                    "when": "false"
                },
                {
                    "command": "sjasmplus-code-lens.dezog.disassemblyAtCursor.string",
                    "when": "false"
                },
                {
                    "command": "sjasmplus-code-lens.dezog.analyzeAtCursor.disassembly",
                    "when": "false"
                },
                {
                    "command": "sjasmplus-code-lens.dezog.analyzeAtCursor.flowChart",
                    "when": "false"
                },
                {
                    "command": "sjasmplus-code-lens.dezog.analyzeAtCursor.callGraph",
                    "when": "false"
                }
            ]
        },
        "languages": [
            {
                "id": "sjasmplus",
                "extensions": [
                    ".asm",
                    ".a80",
                    ".z80",
                    ".inc"
                ],
                "aliases": [
                    "sjasmplus",
                    "Z80 Assembler (sjasmplus)"
                ],
                "configuration": "./config/sjasmplus.language-configuration.json"
            },
            {
                "id": "sjasmplus-list",
                "extensions": [
                    ".lst",
                    ".list",
                    ".lis"
                ],
                "aliases": [
                    "sjasmplus listing"
                ]
            },
            {
                "id": "sjasmplus-markdown-codeblock"
            },
            {
                "id": "sjasmplus-list-markdown-codeblock"
            }
        ],
        "breakpoints": [
            {
                "language": "sjasmplus"
            },
            {
                "language": "sjasmplus-list"
            }
        ],
        "configurationDefaults": {
            "[sjasmplus]": {
                "editor.colorDecorators": false,
                "editor.defaultFormatter": "kolnogorov.sjasmplus-code-lens"
            },
            "[sjasmplus-list]": {
                "editor.colorDecorators": false
            }
        },
        "grammars": [
            {
                "language": "sjasmplus",
                "scopeName": "source.sjasmplus",
                "path": "./grammar/asm.json"
            },
            {
                "language": "sjasmplus-list",
                "scopeName": "source.sjasmplus.list",
                "path": "./grammar/asm_list.json"
            },
            {
                "language": "sjasmplus-markdown-codeblock",
                "scopeName": "markdown.sjasmplus.codeblock",
                "path": "./grammar/asm_markdown_codeblock.json",
                "injectTo": [
                    "text.html.markdown"
                ]
            },
            {
                "language": "sjasmplus-list-markdown-codeblock",
                "scopeName": "markdown.sjasmplus.list.codeblock",
                "path": "./grammar/asm_list_markdown_codeblock.json",
                "injectTo": [
                    "text.html.markdown"
                ]
            }
        ],
        "problemMatchers": [
            {
                "name": "problem-matcher-sjasmplus",
                "owner": "sjasmplus",
                "fileLocation": "autoDetect",
                "pattern": [
                    {
                        "regexp": "^(.*)\\((\\d+)\\):\\s+(warning|error):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "severity": 3,
                        "message": 4
                    }
                ]
            }
        ]
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch-tsc": "tsc -w -p ./",
        "test": "mocha -u tdd ./out/tests/",
        "test:integration": "tsc -p ./ && npm run esbuild-node && npm run esbuild-browser && node ./out/tests/integration/runTest.js",
        "vscode:prepublish": "npm run esbuild-node -- --minify && npm run esbuild-browser -- --minify",
        "esbuild-node": "esbuild ./src/extension.ts --bundle --outdir=out --external:vscode --format=cjs --platform=node",
        "esbuild-browser": "esbuild ./src/html/hexcalc.ts --bundle --outdir=out/html --platform=browser",
        "watch-node": "npm run esbuild-node -- --sourcemap --watch",
        "watch-browser": "npm run esbuild-browser -- --sourcemap --watch",
        "package": "vsce package",
        "publish": "vsce publish"
    },
    "devDependencies": {
        "@types/mocha": "10.0.0",
        "@types/node": "^18.8.2",
        "@types/vscode": "^1.71.0",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^3.9.2",
        "esbuild": "^0.25.0",
        "mocha": "^10.4.0",
        "source-map-support": "^0.5.21",
        "typescript": "^4.8.4",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.3.2"
    }
}
